# Polished Resume Ranking System - Environment Configuration

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Configuration
S3_BUCKET_NAME=polished-batches-us-east-1

# Redis Configuration (optional - falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Premium Features
# Set to 'true' to bypass premium checks (development ONLY - ignored when ENVIRONMENT=production)
PREMIUM_BYPASS=false

# Authentication (Clerk)
# CLERK_ISSUER_URL pins the JWT issuer - REQUIRED in production
# (e.g. https://your-app.clerk.accounts.dev or https://clerk.yourdomain.com)
CLERK_ISSUER_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Set to 'true' to bypass auth (development ONLY - ignored when ENVIRONMENT=production)
AUTH_BYPASS=false

# Email Configuration (optional)
ENABLE_EMAIL=false
FROM_EMAIL=noreply@polished.io

# Admin Configuration
# Comma-separated list of email addresses that should have admin access
ADMIN_EMAILS=admin@polished.io

# LLM Configuration (for deep analysis - optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
